---
/**
 * Wordmark YESTOURS — thiết kế riêng bằng SVG + CSS.
 * Không sao chép logo của bất kỳ công ty nào khác.
 */
interface Props {
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    width="32"
    height="32"
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    <rect
      width="32"
      height="32"
      rx="9"
      fill={onDark ? 'var(--color-ocean-500)' : 'var(--color-ocean-700)'}
    ></rect>
    <path
      d="M9 8 L16 15 L23 8"
      fill="none"
      stroke="#ffffff"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M16 15 L16 20"
      fill="none"
      stroke="#ffffff"
      stroke-width="3"
      stroke-linecap="round"></path>
    <path
      d="M6.5 24.5 q4.75 -3.2 9.5 0 t9.5 0"
      fill="none"
      stroke="var(--color-coral-400)"
      stroke-width="2.4"
      stroke-linecap="round"></path>
  </svg>
  <span
    class:list={[
      'text-xl font-extrabold tracking-tight leading-none',
      onDark ? 'text-white' : 'text-ocean-900',
    ]}
  >
    YES<span class:list={[onDark ? 'text-ocean-300' : 'text-ocean-600', 'font-semibold']}
      >TOURS</span
    >
  </span>
</span>
