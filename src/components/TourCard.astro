---
import { site, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { tourDetail } from './routes';
import type { Tour } from './tours';

interface Props {
  tour: Tour;
  lang: Locale;
  /** Ảnh nằm trong màn hình đầu tiên thì tải ngay, còn lại lazy. */
  eager?: boolean;
}
const { tour, lang, eager = false } = Astro.props;
const tr = t(lang);
const d = tour.data;
const href = tourDetail(lang, d.key);
const hasImage = Boolean(d.image?.trim());

const categoryLabel = {
  inbound: tr('nav.inbound'),
  outbound: tr('nav.outbound'),
  domestic: tr('nav.domestic'),
}[d.category];
---

<article
  data-tour
  data-category={d.category}
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow duration-200 hover:shadow-lg focus-within:ring-2 focus-within:ring-ocean-700 focus-within:ring-offset-2"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-ocean-100">
    {
      hasImage ? (
        <img
          src={d.image}
          alt={d.imageAlt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div
          class="h-full w-full bg-gradient-to-br from-ocean-700 to-ocean-500"
          role="img"
          aria-label={d.imageAlt || d.title}
        />
      )
    }
    <span
      class="absolute top-3 left-3 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ocean-900 shadow-sm"
    >
      {categoryLabel}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="text-lg leading-snug font-bold text-ocean-950">
      <a
        href={href}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >
        {d.title}
      </a>
    </h3>

    <p class="line-clamp-3 text-sm leading-relaxed text-slate-600">{d.summary}</p>

    <dl class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
      <div class="flex gap-1">
        <dt class="sr-only">{tr('tour.duration')}</dt>
        <dd class="font-medium text-slate-700">{d.duration}</dd>
      </div>
      {
        d.destinations.length > 0 && (
          <div class="flex min-w-0 gap-1">
            <dt class="sr-only">{tr('tour.destinations')}</dt>
            <dd class="truncate">{d.destinations.slice(0, 3).join(' · ')}</dd>
          </div>
        )
      }
    </dl>

    <div class="mt-auto flex items-center justify-between gap-3 pt-4">
      <span class="text-sm font-semibold text-ocean-800">
        {!site.showPrices && tr('tour.priceOnRequest')}
      </span>
      <span
        class="inline-flex items-center gap-1 text-sm font-semibold text-coral-700 group-hover:gap-2 motion-safe:transition-all"
        aria-hidden="true"
      >
        {tr('cta.viewTour')}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
</article>
