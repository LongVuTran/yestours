---
import { site } from '../config/site';

/**
 * Nút chat nổi. CHỈ render kênh nào có giá trị trong `site.channels`.
 * Hiện tại mọi kênh đều `null` → component không xuất ra gì cả.
 * Muốn bật: điền giá trị trong `src/config/site.ts`, không cần sửa file này.
 */
const c = site.channels;

type ChatLink = { id: string; label: string; href: string; tone: 'ocean' | 'coral' };

const links: ChatLink[] = [];

if (c.kakaotalk) {
  links.push({
    id: 'kakaotalk',
    label: 'KakaoTalk',
    href: `https://pf.kakao.com/${c.kakaotalk}`,
    tone: 'ocean',
  });
}
if (c.zalo) {
  links.push({
    id: 'zalo',
    label: 'Zalo',
    href: `https://zalo.me/${c.zalo.replace(/[^\d]/g, '')}`,
    tone: 'ocean',
  });
}
if (c.whatsapp) {
  links.push({
    id: 'whatsapp',
    label: 'WhatsApp',
    href: `https://wa.me/${c.whatsapp.replace(/[^\d]/g, '')}`,
    tone: 'ocean',
  });
}
if (c.facebook) {
  links.push({ id: 'facebook', label: 'Facebook', href: c.facebook, tone: 'ocean' });
}
if (c.hotline) {
  links.push({
    id: 'hotline',
    label: c.hotline,
    href: `tel:${c.hotline.replace(/[^\d+]/g, '')}`,
    tone: 'coral',
  });
}
---

{
  links.length > 0 && (
    <div class="fixed right-3 bottom-3 z-40 flex flex-col items-end gap-2 sm:right-5 sm:bottom-5">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('tel:') ? undefined : '_blank'}
          rel={link.href.startsWith('tel:') ? undefined : 'noopener noreferrer'}
          data-channel={link.id}
          class:list={[
            'inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-semibold text-white shadow-lg',
            'transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-900',
            link.tone === 'coral'
              ? 'bg-coral-700 hover:bg-coral-800'
              : 'bg-ocean-700 hover:bg-ocean-800',
          ]}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.6-.7L3 21l1.9-5A8.3 8.3 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z" />
          </svg>
          {link.label}
        </a>
      ))}
    </div>
  )
}
