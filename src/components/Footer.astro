---
import { site, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { home, contact } from './routes';
import Logo from './Logo.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tr = t(lang);

const year = new Date().getFullYear();
const email = site.contact.emailBranded ?? site.contact.email;

const quickLinks = [
  { href: home(lang), label: tr('nav.home') },
  { href: contact(lang), label: tr('nav.contact') },
];
---

<footer class="bg-ocean-950 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo onDark />
        <p class="mt-4 text-sm leading-relaxed text-slate-300">
          {site.company.nameVi}
        </p>
        <p class="text-sm leading-relaxed text-slate-400">
          {site.company.nameEn}
        </p>
        <p class="mt-3 text-sm text-slate-400">
          {tr('footer.since')} {site.company.establishedYear}
        </p>
      </div>

      <div class="lg:col-span-4">
        <h2 class="text-sm font-semibold tracking-wide text-white uppercase">
          {tr('footer.company')}
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
            <dt class="shrink-0 text-slate-400">{tr('footer.taxId')}:</dt>
            <dd class="font-medium text-white">{site.company.taxId}</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
            <dt class="shrink-0 text-slate-400">{tr('footer.address')}:</dt>
            <dd class="text-slate-200">{site.address[lang]}</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
            <dt class="shrink-0 text-slate-400">{tr('footer.phone')}:</dt>
            <dd>
              <a
                href={site.contact.phoneHref}
                class="font-medium text-white underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-300"
              >
                {site.contact.phoneDisplay}
              </a>
            </dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
            <dt class="shrink-0 text-slate-400">{tr('footer.email')}:</dt>
            <dd class="min-w-0 break-words">
              <a
                href={`mailto:${email}`}
                class="font-medium text-white underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-300"
              >
                {email}
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <nav aria-label={tr('footer.quickLinks')} class="lg:col-span-3">
        <h2 class="text-sm font-semibold tracking-wide text-white uppercase">
          {tr('footer.quickLinks')}
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-300 underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-white/10 pt-6 text-xs text-slate-400">
      © {year} {site.company.nameVi} ({site.company.brand}). {tr('footer.rights')}
    </p>
  </div>
</footer>
