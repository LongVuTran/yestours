---
import { categories, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { tx } from './copy';
import { home, toursIndex, about, contact, toursByCategory } from './routes';
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
  current?: 'home' | 'tours' | 'about' | 'contact' | 'terms' | 'none';
  alternates?: Partial<Record<Locale, string>>;
}
const { lang, current = 'none', alternates = {} } = Astro.props;
const tr = t(lang);
const x = tx(lang);

const categoryLabel = {
  inbound: tr('nav.inbound'),
  outbound: tr('nav.outbound'),
  domestic: tr('nav.domestic'),
} as const;

const mainNav = [
  { id: 'home', href: home(lang), label: tr('nav.home') },
  { id: 'tours', href: toursIndex(lang), label: tr('nav.tours') },
  { id: 'about', href: about(lang), label: tr('nav.about') },
  { id: 'contact', href: contact(lang), label: tr('nav.contact') },
] as const;

const linkBase =
  'rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700';
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a
      href={home(lang)}
      class="rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700"
    >
      <Logo />
    </a>

    <!-- Điều hướng desktop -->
    <nav aria-label={x('a11y.menu')} class="hidden items-center gap-1 lg:flex">
      {
        mainNav.map((item) =>
          item.id === 'tours' ? (
            <div class="relative" data-tours-menu>
              <a
                href={item.href}
                aria-current={current === 'tours' ? 'page' : undefined}
                class:list={[
                  linkBase,
                  'inline-flex items-center gap-1',
                  current === 'tours'
                    ? 'bg-ocean-50 text-ocean-800'
                    : 'text-slate-700 hover:bg-slate-100 hover:text-ocean-800',
                ]}
              >
                {item.label}
              </a>
              <button
                type="button"
                data-tours-toggle
                aria-expanded="false"
                aria-controls="tours-submenu"
                class="ml-0.5 rounded-md p-2 text-slate-600 transition-colors hover:bg-slate-100 hover:text-ocean-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700"
              >
                <span class="sr-only">{x('tours.filter.label')}</span>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  data-tours-chevron
                  class="transition-transform"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <ul
                id="tours-submenu"
                hidden
                class="absolute left-0 top-full mt-1 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-xl"
              >
                <li>
                  <a
                    href={item.href}
                    class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-800"
                  >
                    {x('tours.filter.all')}
                  </a>
                </li>
                {categories.map((cat) => (
                  <li>
                    <a
                      href={toursByCategory(lang, cat)}
                      class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-800"
                    >
                      {categoryLabel[cat]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={current === item.id ? 'page' : undefined}
              class:list={[
                linkBase,
                current === item.id
                  ? 'bg-ocean-50 text-ocean-800'
                  : 'text-slate-700 hover:bg-slate-100 hover:text-ocean-800',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch lang={lang} alternates={alternates} class="hidden sm:flex" />
      <a
        href={contact(lang)}
        class="hidden rounded-full bg-coral-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-coral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-800 lg:inline-flex"
      >
        {tr('cta.quote')}
      </a>

      <button
        type="button"
        data-menu-toggle
        data-close-label={x('a11y.closeMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex items-center justify-center rounded-md p-2.5 text-slate-700 transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700 lg:hidden"
      >
        <span class="sr-only" data-menu-label>{x('a11y.openMenu')}</span>
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          data-icon-open
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          data-icon-close
          hidden
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-slate-200 bg-white lg:hidden"
  >
    <nav aria-label={x('a11y.menu')} class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      <ul class="flex flex-col gap-1">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.id ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-3 text-base font-medium',
                  current === item.id
                    ? 'bg-ocean-50 text-ocean-800'
                    : 'text-slate-800 hover:bg-slate-100',
                ]}
              >
                {item.label}
              </a>
              {item.id === 'tours' && (
                <ul class="mt-1 mb-1 ml-3 flex flex-col gap-1 border-l border-slate-200 pl-3">
                  {categories.map((cat) => (
                    <li>
                      <a
                        href={toursByCategory(lang, cat)}
                        class="block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100 hover:text-ocean-800"
                      >
                        {categoryLabel[cat]}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-3">
        <LangSwitch lang={lang} alternates={alternates} class="sm:hidden" />
        <a
          href={contact(lang)}
          class="inline-flex flex-1 items-center justify-center rounded-full bg-coral-700 px-4 py-3 text-sm font-semibold text-white hover:bg-coral-800"
        >
          {tr('cta.quote')}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-menu');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const iconOpen = document.querySelector<SVGElement>('[data-icon-open]');
  const iconClose = document.querySelector<SVGElement>('[data-icon-close]');
  const labels = {
    open: label?.textContent?.trim() ?? 'Menu',
    close: toggle?.dataset.closeLabel ?? '',
  };

  function setMenu(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (iconOpen) iconOpen.hidden = open;
    if (iconClose) iconClose.hidden = !open;
    if (label && labels.close) label.textContent = open ? labels.close : labels.open;
  }

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Dropdown "Tour" trên desktop
  const toursToggle = document.querySelector<HTMLButtonElement>('[data-tours-toggle]');
  const toursMenu = document.getElementById('tours-submenu');
  const chevron = document.querySelector<SVGElement>('[data-tours-chevron]');

  function setTours(open: boolean) {
    if (!toursToggle || !toursMenu) return;
    toursToggle.setAttribute('aria-expanded', String(open));
    toursMenu.hidden = !open;
    chevron?.classList.toggle('rotate-180', open);
  }

  toursToggle?.addEventListener('click', () => {
    setTours(toursToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    const wrapper = document.querySelector('[data-tours-menu]');
    if (wrapper && !wrapper.contains(target)) setTours(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    setTours(false);
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // Đổi kích thước sang desktop thì đóng menu mobile để không kẹt trạng thái.
  const desktop = window.matchMedia('(min-width: 1024px)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
    else setTours(false);
  });
</script>
