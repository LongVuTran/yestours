---
import { locales, localeNames, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { home } from './routes';

interface Props {
  lang: Locale;
  /** URL tương ứng ở từng ngôn ngữ. Thiếu ngôn ngữ nào thì rơi về trang chủ ngôn ngữ đó. */
  alternates?: Partial<Record<Locale, string>>;
  class?: string;
}
const { lang, alternates = {}, class: className = '' } = Astro.props;
const tr = t(lang);
const shortLabel: Record<Locale, string> = { vi: 'VI', en: 'EN', ko: 'KO' };
---

<nav
  aria-label={tr('meta.langSwitch')}
  class:list={['flex items-center gap-0.5 rounded-full bg-slate-100 p-1', className]}
>
  {
    locales.map((l) => {
      const href = alternates[l] ?? home(l);
      const isCurrent = l === lang;
      return (
        <a
          href={href}
          hreflang={l}
          lang={l}
          aria-current={isCurrent ? 'true' : undefined}
          class:list={[
            'rounded-full px-2.5 py-1 text-xs font-semibold transition-colors',
            'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700',
            isCurrent
              ? 'bg-white text-ocean-900 shadow-sm'
              : 'text-slate-600 hover:bg-white/70 hover:text-ocean-800',
          ]}
        >
          <span class="sr-only">{localeNames[l]}</span>
          <span aria-hidden="true">{shortLabel[l]}</span>
        </a>
      );
    })
  }
</nav>
