---
import { site, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { tx } from './copy';
import { contact } from './routes';

interface Props {
  lang: Locale;
  title?: string;
  text?: string;
}
const { lang, title, text } = Astro.props;
const tr = t(lang);
const x = tx(lang);
---

<section class="bg-ocean-900">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-balance text-white sm:text-3xl">
          {title ?? x('ctaband.title')}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-ocean-100">
          {text ?? x('ctaband.text')}
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:flex-row lg:w-auto lg:shrink-0">
        <a
          href={contact(lang)}
          class="inline-flex items-center justify-center rounded-full bg-coral-700 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-coral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {tr('cta.quote')}
        </a>
        <a
          href={site.contact.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {tr('cta.callNow')}
          <span class="font-normal text-ocean-100">{site.contact.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </div>
</section>
