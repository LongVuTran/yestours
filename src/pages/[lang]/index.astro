---
import { locales, categories, type Locale, type Category } from '../../config/site';
import { t, imageAlts } from '../../i18n/ui';
import { tx } from '../../components/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { toursFor, featuredTours, coverImage } from '../../components/tours';
import {
  home,
  toursIndex,
  toursByCategory,
  contact,
  alternatesFor,
} from '../../components/routes';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const tr = t(lang);
const x = tx(lang);

const tours = await toursFor(lang);
const featured = await featuredTours(lang, 6);

// Ảnh hero chuyên dụng, luôn có trong public/images/.
// coverImage() vẫn dùng cho ogImage khi muốn ảnh theo tour tiêu biểu.
const hero = { src: '/images/hero.webp', alt: imageAlts.hero[lang] };
const ogFallback = coverImage(featured) ?? coverImage(tours);

const categoryMeta: Record<Category, { label: string; desc: string }> = {
  inbound: { label: tr('nav.inbound'), desc: x('cat.inbound.desc') },
  outbound: { label: tr('nav.outbound'), desc: x('cat.outbound.desc') },
  domestic: { label: tr('nav.domestic'), desc: x('cat.domestic.desc') },
};

const categoryCovers = Object.fromEntries(
  categories.map((cat) => [
    cat,
    { src: `/images/category-${cat}.webp`, alt: imageAlts[cat][lang] },
  ])
) as Record<Category, { src: string; alt: string }>;

/** Chỉ nêu điều kiểm chứng được từ giấy phép kinh doanh — không thêm thành tích, giải thưởng. */
const why = [
  { title: x('why.1.title'), desc: x('why.1.desc') },
  { title: x('why.2.title'), desc: x('why.2.desc') },
  { title: x('why.3.title'), desc: x('why.3.desc') },
  { title: x('why.4.title'), desc: x('why.4.desc') },
];
---

<BaseLayout
  lang={lang}
  title={`${x('hero.title')} | YESTOURS`}
  description={x('hero.subtitle')}
  canonical={home(lang)}
  alternates={alternatesFor(home)}
  ogImage={hero.src ?? ogFallback?.src}
  current="home"
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ocean-950">
    {
      hero && (
        <img
          src={hero.src}
          alt={hero.alt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60"
        />
      )
    }
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-ocean-950/90 via-ocean-950/70 to-ocean-900/60"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wide text-ocean-200 uppercase">
          {x('hero.eyebrow')}
        </p>
        <h1
          class="mt-4 text-4xl leading-tight font-extrabold text-balance text-white sm:text-5xl lg:text-6xl"
        >
          {x('hero.title')}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ocean-100 sm:text-xl">
          {x('hero.subtitle')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={toursIndex(lang)}
            class="inline-flex items-center justify-center rounded-full bg-coral-700 px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-coral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {tr('cta.allTours')}
          </a>
          <a
            href={contact(lang)}
            class="inline-flex items-center justify-center rounded-full border border-white/50 bg-white/5 px-7 py-4 text-base font-semibold text-white backdrop-blur transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {tr('cta.quote')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Ba nhóm dịch vụ -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance text-ocean-950 sm:text-4xl">
        {x('home.categories.title')}
      </h2>
      <p class="mt-3 text-lg text-slate-600">{x('home.categories.subtitle')}</p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => {
          const cover = categoryCovers[cat];
          return (
            <li>
              <a
                href={toursByCategory(lang, cat)}
                class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700"
              >
                <div class="relative aspect-[16/10] overflow-hidden bg-ocean-100">
                  {cover ? (
                    <img
                      src={cover.src}
                      alt={cover.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <div class="h-full w-full bg-gradient-to-br from-ocean-800 to-ocean-500" />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-xl font-bold text-ocean-950">{categoryMeta[cat].label}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">
                    {categoryMeta[cat].desc}
                  </p>
                  <span
                    class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-coral-700 group-hover:gap-2 motion-safe:transition-all"
                    aria-hidden="true"
                  >
                    {tr('cta.allTours')}
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Tour tiêu biểu -->
  {
    featured.length > 0 && (
      <section class="bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="max-w-2xl">
              <h2 class="text-3xl font-bold text-balance text-ocean-950 sm:text-4xl">
                {x('home.featured.title')}
              </h2>
              <p class="mt-3 text-lg text-slate-600">{x('home.featured.subtitle')}</p>
            </div>
            <a
              href={toursIndex(lang)}
              class="inline-flex items-center gap-1 rounded-full px-1 py-1 text-sm font-semibold text-ocean-800 underline underline-offset-4 hover:text-ocean-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocean-700"
            >
              {tr('cta.allTours')}
            </a>
          </div>

          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((tour, i) => (
              <li class="h-full">
                <TourCard tour={tour} lang={lang} eager={i < 3} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Vì sao chọn YESTOURS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <h2 class="max-w-2xl text-3xl font-bold text-balance text-ocean-950 sm:text-4xl">
      {x('home.why.title')}
    </h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        why.map((item, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span
              class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-ocean-50 text-base font-bold text-ocean-800"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-ocean-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
