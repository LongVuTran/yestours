---
import { site, locales, type Locale } from '../../config/site';
import { t } from '../../i18n/ui';
import { tx } from '../../components/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { heroImage } from '../../components/media';
import { home, contact, alternatesFor } from '../../components/routes';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const tr = t(lang);
const x = tx(lang);

// Ảnh hero chuyên dụng; thiếu file thì hero chỉ còn nền gradient.
const hero = heroImage(lang);

const services = [
  { title: x('svc.1.title'), desc: x('svc.1.desc') },
  { title: x('svc.2.title'), desc: x('svc.2.desc') },
];

/** Chỉ nêu điều kiểm chứng được từ giấy phép kinh doanh — không thêm thành tích, giải thưởng. */
const why = [
  { title: x('why.1.title'), desc: x('why.1.desc') },
  { title: x('why.2.title'), desc: x('why.2.desc') },
  { title: x('why.3.title'), desc: x('why.3.desc') },
  { title: x('why.4.title'), desc: x('why.4.desc') },
];
---

<BaseLayout
  lang={lang}
  title={`${x('hero.title')} | YESTOURS`}
  description={x('hero.subtitle')}
  canonical={home(lang)}
  alternates={alternatesFor(home)}
  ogImage={hero?.src}
  current="home"
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ocean-950">
    {
      hero && (
        <img
          src={hero.src}
          alt={hero.alt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 z-0 h-full w-full object-cover"
        />
      )
    }
    <div
      class="absolute inset-0 z-0 bg-gradient-to-r from-ocean-950/92 via-ocean-950/80 to-ocean-950/50"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wide text-ocean-200 uppercase">
          {x('hero.eyebrow')}
        </p>
        <h1
          class="mt-4 text-4xl leading-tight font-extrabold text-balance text-white sm:text-5xl lg:text-6xl"
        >
          {x('hero.title')}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ocean-100 sm:text-xl">
          {x('hero.subtitle')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.contact.phoneHref}
            class="inline-flex items-center justify-center rounded-full bg-coral-700 px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-coral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {tr('cta.callNow')}
            <span class="ml-2 font-normal text-white/90">{site.contact.phoneDisplay}</span>
          </a>
          <a
            href={contact(lang)}
            class="inline-flex items-center justify-center rounded-full border border-white/50 bg-white/5 px-7 py-4 text-base font-semibold text-white backdrop-blur transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {tr('cta.quote')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hai dịch vụ -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-balance text-ocean-950 sm:text-4xl">
        {x('home.categories.title')}
      </h2>
      <p class="mt-3 text-lg text-slate-600">{x('home.categories.subtitle')}</p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        services.map((item) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-ocean-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Vì sao chọn YESTOURS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <h2 class="max-w-2xl text-3xl font-bold text-balance text-ocean-950 sm:text-4xl">
      {x('home.why.title')}
    </h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        why.map((item, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span
              class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-ocean-50 text-base font-bold text-ocean-800"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-ocean-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
