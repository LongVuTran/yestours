---
import { render } from 'astro:content';
import { site, type Locale } from '../../../config/site';
import { t, routeSlugs } from '../../../i18n/ui';
import { tx } from '../../../components/copy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourCard from '../../../components/TourCard.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { allTours, tourLangIndex, type Tour } from '../../../components/tours';
import { home, toursIndex, tourDetail } from '../../../components/routes';

export async function getStaticPaths() {
  const tours = await allTours();
  const langIndex = await tourLangIndex();

  return tours.map((entry) => {
    const entryLang = entry.data.lang;
    const related = tours
      .filter(
        (other) =>
          other.data.lang === entryLang &&
          other.data.key !== entry.data.key &&
          other.data.category === entry.data.category
      )
      .slice(0, 3);

    return {
      params: {
        lang: entryLang,
        toursSlug: routeSlugs.tours[entryLang],
        key: entry.data.key,
      },
      props: {
        entry,
        related,
        availableLangs: langIndex.get(entry.data.key) ?? [entryLang],
      },
    };
  });
}

interface Props {
  entry: Tour;
  related: Tour[];
  availableLangs: Locale[];
}

const { entry, related, availableLangs } = Astro.props;
const lang = entry.data.lang;
const tr = t(lang);
const x = tx(lang);
const d = entry.data;

const alternates = Object.fromEntries(
  availableLangs.map((l) => [l, tourDetail(l, d.key)])
) as Partial<Record<Locale, string>>;

const categoryLabel = {
  inbound: tr('nav.inbound'),
  outbound: tr('nav.outbound'),
  domestic: tr('nav.domestic'),
}[d.category];

const hasImage = Boolean(d.image?.trim());
const hasBody = Boolean(entry.body?.trim());
const { Content } = await render(entry);

const facts = [
  { label: tr('tour.duration'), value: d.duration },
  { label: tr('tour.departFrom'), value: d.departFrom },
  { label: tr('tour.destinations'), value: d.destinations.join(' · ') },
];
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.summary}
  canonical={tourDetail(lang, d.key)}
  alternates={alternates}
  ogImage={hasImage ? d.image : undefined}
  ogType="article"
  current="tours"
  needsReview={d.needsReview}
>
  <!-- Ảnh lớn + tiêu đề -->
  <section class="relative isolate overflow-hidden bg-ocean-950">
    {
      hasImage && (
        <img
          src={d.image}
          alt={d.imageAlt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-10 h-full w-full object-cover opacity-55"
        />
      )
    }
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-ocean-950 via-ocean-950/75 to-ocean-900/50"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 pt-8 pb-14 sm:px-6 lg:px-8 lg:pt-10 lg:pb-20">
      <nav aria-label={x('a11y.breadcrumb')} class="text-sm text-ocean-200">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li>
            <a href={home(lang)} class="underline-offset-4 hover:text-white hover:underline">
              {tr('nav.home')}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={toursIndex(lang)}
              class="underline-offset-4 hover:text-white hover:underline"
            >
              {tr('nav.tours')}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">{d.title}</li>
        </ol>
      </nav>

      <span
        class="mt-6 inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white backdrop-blur"
      >
        {categoryLabel}
      </span>
      <h1
        class="mt-3 max-w-4xl text-3xl leading-tight font-extrabold text-balance text-white sm:text-4xl lg:text-5xl"
      >
        {d.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ocean-100">{d.summary}</p>
      {
        d.imageCredit && hasImage && (
          // Nguồn ảnh in nguyên văn: chuỗi trong content đã tự kèm nhãn "Ảnh:" / "Photo:".
          <p class="mt-6 text-xs text-ocean-300">{d.imageCredit}</p>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <!-- Thông tin nhanh -->
        <section aria-labelledby="quick-facts">
          <h2 id="quick-facts" class="sr-only">{x('tour.quickFacts')}</h2>
          <dl class="grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:grid-cols-3">
            {
              facts.map((fact) => (
                <div>
                  <dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase">
                    {fact.label}
                  </dt>
                  <dd class="mt-1 text-sm font-semibold text-ocean-950">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Điểm nổi bật -->
        <section class="mt-12" aria-labelledby="highlights">
          <h2 id="highlights" class="text-2xl font-bold text-ocean-950">
            {tr('tour.highlights')}
          </h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              d.highlights.map((item) => (
                <li class="flex gap-3 rounded-xl border border-slate-200 p-4">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="mt-0.5 shrink-0 text-coral-700"
                  >
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                  <span class="text-sm leading-relaxed text-slate-700">{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Lịch trình theo ngày -->
        <section class="mt-12" aria-labelledby="itinerary">
          <h2 id="itinerary" class="text-2xl font-bold text-ocean-950">
            {tr('tour.itinerary')}
          </h2>
          <ol class="mt-6 space-y-0">
            {
              d.itinerary.map((day, i) => (
                <li class="relative flex gap-4 pb-8 last:pb-0 sm:gap-6">
                  {i < d.itinerary.length - 1 && (
                    <span
                      aria-hidden="true"
                      class="absolute top-10 bottom-0 left-4 w-px bg-ocean-200 sm:left-5"
                    />
                  )}
                  <span
                    aria-hidden="true"
                    class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ocean-800 text-xs font-bold text-white sm:h-10 sm:w-10 sm:text-sm"
                  >
                    {i + 1}
                  </span>
                  <div class="min-w-0 flex-1 pt-0.5">
                    <p class="text-xs font-semibold tracking-wide text-ocean-700 uppercase">
                      {day.day}
                    </p>
                    <h3 class="mt-1 text-lg font-bold text-ocean-950">{day.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600">{day.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- Bao gồm / Không bao gồm -->
        {
          (d.included.length > 0 || d.excluded.length > 0) && (
            <section class="mt-12 grid gap-6 sm:grid-cols-2">
              {d.included.length > 0 && (
                <div class="rounded-2xl border border-slate-200 p-6">
                  <h2 class="text-lg font-bold text-ocean-950">{tr('tour.included')}</h2>
                  <ul class="mt-4 space-y-2.5 text-sm text-slate-700">
                    {d.included.map((item) => (
                      <li class="flex gap-2.5">
                        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ocean-600" />
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {d.excluded.length > 0 && (
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
                  <h2 class="text-lg font-bold text-ocean-950">{tr('tour.excluded')}</h2>
                  <ul class="mt-4 space-y-2.5 text-sm text-slate-600">
                    {d.excluded.map((item) => (
                      <li class="flex gap-2.5">
                        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" />
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )
        }

        {
          hasBody && (
            <section class="prose-yes mt-12 max-w-none">
              <Content />
            </section>
          )
        }

        <p class="mt-12">
          <a
            href={toursIndex(lang)}
            class="inline-flex items-center gap-2 text-sm font-semibold text-ocean-800 underline underline-offset-4 hover:text-ocean-950"
          >
            <span aria-hidden="true">&larr;</span>
            {x('tour.back')}
          </a>
        </p>
      </div>

      <!-- Cột phải: khối liên hệ nhận báo giá -->
      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-24">
          <div class="rounded-2xl border border-ocean-200 bg-ocean-50 p-6">
            <p class="text-sm font-semibold text-ocean-800">{tr('tour.priceOnRequest')}</p>
            <h2 class="mt-2 text-xl font-bold text-ocean-950">{x('tour.ctaTitle')}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{x('tour.ctaText')}</p>

            <a
              href={site.contact.phoneHref}
              class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-coral-700 px-5 py-3.5 text-base font-semibold text-white transition-colors hover:bg-coral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-800"
            >
              {tr('cta.callNow')} · {site.contact.phoneDisplay}
            </a>
          </div>

          <div class="mt-6 rounded-2xl border border-slate-200 p-6">
            <h2 class="text-lg font-bold text-ocean-950">{tr('form.title')}</h2>
            <div class="mt-4">
              <ContactForm lang={lang} subjectContext={d.title} />
            </div>
          </div>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 border-t border-slate-200 pt-12">
          <h2 class="text-2xl font-bold text-ocean-950">{tr('cta.allTours')}</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((tour) => (
              <li class="h-full">
                <TourCard tour={tour} lang={lang} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
